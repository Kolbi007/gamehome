<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3-klienten: Home, Library, Search, Settings, Nye funn.
    Single-project MSIX: pakkemanifestet ligger her (se docs/adr/0002-single-project-msix.md).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(GameHomeWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(GameHomeWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(GameHomeWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>GameHome.App</RootNamespace>
    <AssemblyName>GameHome</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- Sideloading for testing på Legion Go; ingen Store-innsending. -->
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!--
      Advar ved bygging når WinRT-marshalling ikke er AOT-sikker (for eksempel en .NET-samling som ItemsSource).
      Advarsler er feil i CI, så slike feil stoppes før de når Legion Go.
    -->
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- Egen Main i Program.cs for single-instance og videresending av aktivering. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateKeyFile)' != '' or '$(PackageCertificateThumbprint)' != ''">true</AppxPackageSigningEnabled>
  </PropertyGroup>

  <!--
    Native AOT-variant (-p:GameHomeAot=true): forhåndskompilert maskinkode, ubrukt kode fjernes.
    Måles mot vanlig .NET i fase 0B før den blir standard. Krever C++-byggeverktøy (MSVC) på byggemaskinen.
  -->
  <PropertyGroup Condition="'$(GameHomeAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**\*.png" />
    <!--
      Fase 0A: FSE-registrering. SCCD må ligge i pakkeroten; Public er mappen app-utvidelsen peker på.
      SCCD-filen skal ikke ha kommentarer eller andre tegn enn ASCII: Windows avviser den da med 0x8007007A.
      Den er ikke signert av Microsoft og godtas bare med utviklermodus. Mønster fra AnyFSE (MIT).
    -->
    <Content Include="CustomCapability.SCCD" />
    <Content Include="Public\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameHome.Core\GameHome.Core.csproj" />
    <ProjectReference Include="..\GameHome.Data\GameHome.Data.csproj" />
    <ProjectReference Include="..\GameHome.Metadata\GameHome.Metadata.csproj" />
    <ProjectReference Include="..\GameHome.Sources\GameHome.Sources.csproj" />
    <ProjectReference Include="..\GameHome.Windows\GameHome.Windows.csproj" />
    <ProjectReference Include="..\GameHome.Windows.Fse\GameHome.Windows.Fse.csproj" />
  </ItemGroup>
</Project>
