<!-- Fase 1: Home med spill lagt til manuelt, øktmeny og diagnostikk. -->
<Window
    x:Class="GameHome.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameHome">
    <Grid x:Name="Root" Background="#0B0D10">
        <Grid x:Name="Surface" Padding="40,48,40,32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Strømvalg: små ikoner i hjørnet, ikke midt på skjermen. Hvert valg bekreftes. -->
                <StackPanel x:Name="PowerButtons" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Tag="sleep" Click="PowerButton_Click" Width="56" Height="56" AutomationProperties.Name="Dvale" ToolTipService.ToolTip="Dvale">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE708;" FontSize="22" />
                    </Button>
                    <Button Tag="restart" Click="PowerButton_Click" Width="56" Height="56" AutomationProperties.Name="Start på nytt" ToolTipService.ToolTip="Start på nytt">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="22" />
                    </Button>
                    <Button Tag="shutdown" Click="PowerButton_Click" Width="56" Height="56" AutomationProperties.Name="Slå av" ToolTipService.ToolTip="Slå av">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="22" />
                    </Button>
                </StackPanel>
                <Border Grid.Column="0" Background="#1A1E24" CornerRadius="8" Padding="16,10" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="MemoryText" FontFamily="Consolas" FontSize="18" Foreground="White" Text="Minne: –" />
                        <TextBlock x:Name="StartupText" FontFamily="Consolas" FontSize="14" Foreground="#A0A7B0" Text="Oppstart: –" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="GameHome" FontSize="36" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="InfoText" FontSize="16" Foreground="#A0A7B0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Spillflisene lages i koden (ikke ItemsSource; se ADR 0005 om AOT). -->
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GameTiles" Orientation="Horizontal" Spacing="16" />
            </ScrollViewer>

            <StackPanel x:Name="ToolTiles" Grid.Row="2" Orientation="Horizontal" Spacing="16">
                <Button x:Name="AddGameTile" Content="+ Legg til spill" Click="AddGameTile_Click" Width="240" Height="72" FontSize="18" />
                <Button x:Name="HidTile" Content="Lytt på Legion-knapp" Click="HidTile_Click" Width="240" Height="72" FontSize="18" />
            </StackPanel>

            <TextBlock x:Name="LastInput" Grid.Row="3" FontSize="20" Foreground="White"
                       Text="A starter spillet, Y fjerner det fra GameHome. M2 under spill åpner menyen." />

            <!-- Vanlig tekst, ikke liste: en .NET-samling som ItemsSource krever ekstra AOT-generering (se loggen 2026-11-02). -->
            <TextBlock x:Name="EventText" Grid.Row="4" FontFamily="Consolas" FontSize="13" Foreground="#8A9199" TextWrapping="NoWrap" />
        </Grid>

        <!--
          Lasteskjerm mens spillet starter: logo over et mørkt bakgrunnsbilde, eller tittelen i stor tekst.
          Forsvinner når spillet tar forgrunnen. B går tilbake til Home uten å stoppe spillet.
        -->
        <Grid x:Name="LoadingPanel" Background="#0B0D10" Visibility="Collapsed">
            <Grid.Resources>
                <Storyboard x:Name="LoadingPulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="LoadingCenter" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.55" Duration="0:0:1.1">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Image x:Name="LoadingHero" Stretch="UniformToFill" Opacity="0.35" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#550B0D10" Offset="0" />
                        <GradientStop Color="#F00B0D10" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="LoadingCenter" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="LoadingLogo" MaxWidth="720" MaxHeight="300" Stretch="Uniform" />
                <TextBlock x:Name="LoadingTitle" FontSize="64" FontWeight="SemiBold" Foreground="White"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1000" />
            </Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56" Spacing="20">
                <TextBlock x:Name="LoadingStatus" FontSize="20" Foreground="#C8CDD3" HorizontalAlignment="Center" />
                <StackPanel x:Name="LoadingChoices" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="LoadingWaitButton" Content="Vent" Click="LoadingWaitButton_Click" Width="240" Height="64" FontSize="20" />
                    <Button x:Name="LoadingHomeButton" Content="Tilbake til Home" Click="LoadingHomeButton_Click" Width="240" Height="64" FontSize="20" />
                </StackPanel>
                <TextBlock Text="B: tilbake til Home (spillet fortsetter å starte)" FontSize="16" Foreground="#8A9199" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- «Kjører nå»: fullskjermspanel. Ingen overlay over spillet; GameHome tar forgrunnen. -->
        <Grid x:Name="SessionPanel" Background="#F00B0D10" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="560">
                <TextBlock Text="Kjører nå" FontSize="20" Foreground="#A0A7B0" />
                <TextBlock x:Name="SessionTitle" FontSize="40" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionDetail" FontSize="16" Foreground="#A0A7B0" TextWrapping="Wrap" />
                <Button x:Name="ResumeButton" Content="Tilbake til spillet" Click="ResumeButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="EndSessionButton" Content="Avslutt spillet" Click="EndSessionButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="ClosePanelButton" Content="Lukk panelet" Click="ClosePanelButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <StackPanel x:Name="SessionPowerButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Tag="sleep" Click="PowerButton_Click" Width="52" Height="52" AutomationProperties.Name="Dvale" ToolTipService.ToolTip="Dvale">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE708;" FontSize="20" />
                    </Button>
                    <Button Tag="restart" Click="PowerButton_Click" Width="52" Height="52" AutomationProperties.Name="Start på nytt" ToolTipService.ToolTip="Start på nytt">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="20" />
                    </Button>
                    <Button Tag="shutdown" Click="PowerButton_Click" Width="52" Height="52" AutomationProperties.Name="Slå av" ToolTipService.ToolTip="Slå av">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="20" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Valg ved feil og bekreftelser. Alltid to tydelige valg, aldri en blindvei. -->
        <Grid x:Name="MessagePanel" Background="#F00B0D10" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="620">
                <TextBlock x:Name="MessageTitle" FontSize="34" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" FontSize="18" Foreground="#C8CDD3" TextWrapping="Wrap" />
                <Button x:Name="MessagePrimary" Click="MessagePrimary_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="MessageSecondary" Click="MessageSecondary_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
