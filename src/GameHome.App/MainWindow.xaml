<!-- Fase 1: Home med spill lagt til manuelt, øktmeny og diagnostikk. -->
<Window
    x:Class="GameHome.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameHome">
    <Grid x:Name="Root" Background="#0B0D10">
        <Grid.Resources>
            <Storyboard x:Name="AmbientFadeIn">
                <DoubleAnimation Storyboard.TargetName="AmbientImage" Storyboard.TargetProperty="Opacity"
                                 From="0" To="0.55" Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <!--
          «Ambilight»: bildet fra spillet i fokus, dekodet svært lite og strukket ut (gir en naturlig uskarphet uten
          effektbibliotek), dempet under et mørkt slør. Toner inn når fokus flytter seg.
        -->
        <Image x:Name="AmbientImage" Stretch="UniformToFill" Opacity="0" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#990B0D10" Offset="0" />
                    <GradientStop Color="#660B0D10" Offset="0.45" />
                    <GradientStop Color="#F00B0D10" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="Surface" Padding="40,48,40,32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Strøm: ett lite ikon i hjørnet som åpner valgene. -->
                <Button x:Name="PowerMenuButton" Grid.Column="2" Click="PowerMenuButton_Click" Width="56" Height="56" VerticalAlignment="Top"
                        AutomationProperties.Name="Strøm" ToolTipService.ToolTip="Strøm">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="22" />
                </Button>
                <Border Grid.Column="0" Background="#1A1E24" CornerRadius="8" Padding="16,10" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="MemoryText" FontFamily="Consolas" FontSize="18" Foreground="White" Text="Minne: –" />
                        <TextBlock x:Name="StartupText" FontFamily="Consolas" FontSize="14" Foreground="#A0A7B0" Text="Oppstart: –" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="GameHome" FontSize="36" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="InfoText" FontSize="16" Foreground="#A0A7B0" TextWrapping="Wrap" />
                    <!-- Fremdrift når bilder hentes i bakgrunnen. -->
                    <StackPanel x:Name="ArtProgressPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <ProgressBar x:Name="ArtProgress" Width="200" VerticalAlignment="Center" />
                        <TextBlock x:Name="ArtProgressText" FontSize="14" Foreground="#A0A7B0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Spillflisene lages i koden (ikke ItemsSource; se ADR 0005 om AOT). -->
            <!-- Plass rundt flisene så flisen i fokus kan forstørres uten å bli klippet. -->
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="12,14">
                <StackPanel x:Name="GameTiles" Orientation="Horizontal" Spacing="22" />
            </ScrollViewer>

            <StackPanel x:Name="ToolTiles" Grid.Row="2" Orientation="Horizontal" Spacing="16">
                <Button x:Name="AddGameTile" Content="+ Legg til spill" Click="AddGameTile_Click" Width="240" Height="72" FontSize="18" />
                <Button x:Name="HostTile" Content="Spill fra gaming-PC" Click="HostTile_Click" Width="240" Height="72" FontSize="18" />
                <Button x:Name="TestHostTile" Content="Test tilkobling" Click="TestHostTile_Click" Width="240" Height="72" FontSize="18" />
                <Button x:Name="HidTile" Content="Lytt på Legion-knapp" Click="HidTile_Click" Width="240" Height="72" FontSize="18" />
            </StackPanel>

            <TextBlock x:Name="LastInput" Grid.Row="3" FontSize="20" Foreground="White"
                       Text="A starter spillet, Y fjerner det fra GameHome. M2 under spill åpner menyen." />

            <!-- Vanlig tekst, ikke liste: en .NET-samling som ItemsSource krever ekstra AOT-generering (se loggen 2026-11-02). -->
            <TextBlock x:Name="EventText" Grid.Row="4" FontFamily="Consolas" FontSize="13" Foreground="#8A9199" TextWrapping="NoWrap" />
        </Grid>

        <!--
          Lasteskjerm mens spillet starter: logo over et mørkt bakgrunnsbilde, eller tittelen i stor tekst.
          Forsvinner når spillet tar forgrunnen. B går tilbake til Home uten å stoppe spillet.
        -->
        <!--
          Lærdom fra Stremio og Nuvio (docs/architecture.md, «Lasteskjerm»): bakgrunnsbilde som fyller skjermen under et
          mørkt slør fra topp til bunn, logo midt på som toner inn og «puster» rolig, og status rett under logoen.
          Bakgrunnen glir svært sakte inn (egen idé, ikke fra appene). Skjules uten uttoning, som i Stremio.
        -->
        <Grid x:Name="LoadingPanel" Background="Black" Visibility="Collapsed">
            <Grid.Resources>
                <Storyboard x:Name="LoadingIntro">
                    <DoubleAnimation Storyboard.TargetName="LoadingHero" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5" />
                    <DoubleAnimation Storyboard.TargetName="LoadingCenter" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.65">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="LoadingPulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.04" Duration="0:0:2">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.04" Duration="0:0:2">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="HeroDrift">
                    <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.06" Duration="0:0:20" />
                    <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.06" Duration="0:0:20" />
                </Storyboard>
            </Grid.Resources>
            <Image x:Name="LoadingHero" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top"
                   RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="HeroScale" />
                </Image.RenderTransform>
            </Image>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4D000000" Offset="0" />
                        <GradientStop Color="#99000000" Offset="0.35" />
                        <GradientStop Color="#CC000000" Offset="0.7" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Grid x:Name="LoadingCenter" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" />
                    </Grid.RenderTransform>
                    <Image x:Name="LoadingLogo" MaxWidth="560" MaxHeight="300" Stretch="Uniform" />
                    <TextBlock x:Name="LoadingTitle" FontSize="56" FontWeight="ExtraBold" Foreground="White"
                               TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" MaxWidth="1000" />
                </Grid>
                <TextBlock x:Name="LoadingStatus" FontSize="20" Foreground="#B8FFFFFF" HorizontalAlignment="Center" Height="32" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56" Spacing="20">
                <StackPanel x:Name="LoadingChoices" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="LoadingWaitButton" Content="Vent" Click="LoadingWaitButton_Click" Width="240" Height="64" FontSize="20" />
                    <Button x:Name="LoadingHomeButton" Content="Tilbake til Home" Click="LoadingHomeButton_Click" Width="240" Height="64" FontSize="20" />
                </StackPanel>
                <TextBlock Text="B: tilbake til Home (spillet fortsetter å starte)" FontSize="16" Foreground="#8A9199" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- «Kjører nå»: fullskjermspanel. Ingen overlay over spillet; GameHome tar forgrunnen. -->
        <Grid x:Name="SessionPanel" Background="#F00B0D10" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="560">
                <TextBlock Text="Kjører nå" FontSize="20" Foreground="#A0A7B0" />
                <TextBlock x:Name="SessionTitle" FontSize="40" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionDetail" FontSize="16" Foreground="#A0A7B0" TextWrapping="Wrap" />
                <Button x:Name="ResumeButton" Content="Tilbake til spillet" Click="ResumeButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="EndSessionButton" Content="Avslutt spillet" Click="EndSessionButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="EndRemoteButton" Content="Avslutt spillet på gaming-PC-en" Click="EndRemoteButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" Visibility="Collapsed" />
                <Button x:Name="ClosePanelButton" Content="Lukk panelet" Click="ClosePanelButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="SessionPowerButton" Click="PowerMenuButton_Click" Width="52" Height="52" HorizontalAlignment="Right" Margin="0,8,0,0"
                        AutomationProperties.Name="Strøm" ToolTipService.ToolTip="Strøm">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="20" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Spill på PC-en: undermeny der brukeren velger hvilke installerte spill på gaming-PC-en som skal i Home. -->
        <Grid x:Name="HostPanel" Background="#F00B0D10" Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HostTitle" Grid.Row="0" Text="Spill fra gaming-PC" FontSize="34" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="HostStatus" Grid.Row="1" FontSize="18" Foreground="#C8CDD3" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HostGames" Spacing="8" />
                </ScrollViewer>
                <Button x:Name="HostCloseButton" Grid.Row="3" Content="Lukk" Click="HostCloseButton_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20" />
            </Grid>
        </Grid>

        <!-- Strømvalg. Avbryt har fokus, så et feiltrykk på A gjør ingenting. -->
        <Grid x:Name="PowerPanel" Background="#F00B0D10" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="560">
                <TextBlock Text="Strøm" FontSize="34" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="PowerText" FontSize="18" Foreground="#C8CDD3" TextWrapping="Wrap" />
                <Button Tag="sleep" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE708;" FontSize="20" />
                        <TextBlock Text="Dvale" />
                    </StackPanel>
                </Button>
                <Button Tag="restart" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="20" />
                        <TextBlock Text="Start på nytt" />
                    </StackPanel>
                </Button>
                <Button Tag="shutdown" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="20" />
                        <TextBlock Text="Slå av" />
                    </StackPanel>
                </Button>
                <Button Tag="exit" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;" FontSize="20" />
                        <TextBlock Text="Avslutt GameHome" />
                    </StackPanel>
                </Button>
                <Button x:Name="PowerCancelButton" Content="Avbryt" Click="PowerCancel_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20" />
            </StackPanel>
        </Grid>

        <!-- Valg ved feil og bekreftelser. Alltid to tydelige valg, aldri en blindvei. -->
        <Grid x:Name="MessagePanel" Background="#F00B0D10" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="620">
                <TextBlock x:Name="MessageTitle" FontSize="34" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" FontSize="18" Foreground="#C8CDD3" TextWrapping="Wrap" />
                <Button x:Name="MessagePrimary" Click="MessagePrimary_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="MessageSecondary" Click="MessageSecondary_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
