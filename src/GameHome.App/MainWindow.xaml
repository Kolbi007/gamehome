<!-- Testflate for fase 0A og 0B: fokus, input, aktivering, øktmeny, oppstartstid og minne. -->
<Window
    x:Class="GameHome.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameHome">
    <Grid x:Name="Root" Background="#0B0D10">
        <Grid x:Name="Surface" Padding="40,48,40,32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1A1E24" CornerRadius="8" Padding="16,10" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="MemoryText" FontFamily="Consolas" FontSize="18" Foreground="White" Text="Minne: –" />
                        <TextBlock x:Name="StartupText" FontFamily="Consolas" FontSize="14" Foreground="#A0A7B0" Text="Oppstart: –" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="GameHome · testflate" FontSize="36" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="InfoText" FontSize="16" Foreground="#A0A7B0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid x:Name="Tiles" Grid.Row="1" HorizontalAlignment="Center" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110" />
                    <RowDefinition Height="110" />
                </Grid.RowDefinitions>
                <Button x:Name="SessionTile" Grid.Row="0" Grid.Column="0" Content="Start testøkt" Click="Tile_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" />
                <Button x:Name="HidTile" Grid.Row="0" Grid.Column="1" Content="Lytt på Legion-knapp" Click="Tile_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" />
                <Button Grid.Row="0" Grid.Column="2" Content="Flis 3" Click="Tile_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" />
                <Button Grid.Row="1" Grid.Column="0" Content="Flis 4" Click="Tile_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" />
                <Button Grid.Row="1" Grid.Column="1" Content="Flis 5" Click="Tile_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" />
                <Button Grid.Row="1" Grid.Column="2" Content="Flis 6" Click="Tile_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" />
            </Grid>

            <TextBlock x:Name="LastInput" Grid.Row="2" HorizontalAlignment="Center" FontSize="22" Foreground="White" Text="Trykk på en knapp på kontrolleren eller en flis" />

            <!-- Vanlig tekst, ikke liste: en .NET-samling som ItemsSource krever ekstra AOT-generering (se loggen 2026-11-02). -->
            <TextBlock x:Name="EventText" Grid.Row="3" FontFamily="Consolas" FontSize="14" Foreground="#C8CDD3" TextWrapping="NoWrap" />
        </Grid>

        <!-- «Kjører nå»: fullskjermspanel over testflaten. Ingen overlay over spillet; GameHome tar forgrunnen. -->
        <Grid x:Name="SessionPanel" Background="#E60B0D10" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="560">
                <TextBlock Text="Kjører nå" FontSize="20" Foreground="#A0A7B0" />
                <TextBlock x:Name="SessionTitle" FontSize="40" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <Button x:Name="ResumeButton" Content="Tilbake til spillet" Click="ResumeButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="EndSessionButton" Content="Avslutt testøkt" Click="EndSessionButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="ClosePanelButton" Content="Lukk panelet" Click="ClosePanelButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
