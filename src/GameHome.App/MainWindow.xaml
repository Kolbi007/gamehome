<Window
    x:Class="GameHome.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameHome">
    <Grid Background="#0B0D10" Padding="48">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="GameHome" FontSize="48" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="Skjelett for fase 0A" FontSize="20" Foreground="#A0A7B0" HorizontalAlignment="Center" />
            <Button x:Name="FocusProbe" Content="Kontrollerfokus" HorizontalAlignment="Center" XYFocusKeyboardNavigation="Enabled" />
        </StackPanel>
    </Grid>
</Window>
