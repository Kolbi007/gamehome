<!-- Fase 1: Home med spill lagt til manuelt, øktmeny og diagnostikk. -->
<Window
    x:Class="GameHome.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameHome">
    <Grid x:Name="Root" Background="{StaticResource GhBaseBrush}">
        <!--
          Bakgrunn: bakgrunnsbildet (hero) til spillet i fokus i full størrelse, eller omslaget sterkt uskarpt når det
          ikke finnes hero («ambilight»). Bildet toner over når fokus flytter seg. Slør fra venstre og nedenfra holder
          teksten lesbar; ingen pynt utover det.
        -->
        <Image x:Name="AmbientImage" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />
        <Image x:Name="AmbientImageB" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E6121110" Offset="0" />
                    <GradientStop Color="#99121110" Offset="0.45" />
                    <GradientStop Color="#1A121110" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66121110" Offset="0" />
                    <GradientStop Color="#00121110" Offset="0.25" />
                    <GradientStop Color="#B3121110" Offset="0.62" />
                    <GradientStop Color="#FF121110" Offset="0.86" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="Surface" Padding="{StaticResource GhPageMargin}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toppen: stille. Navnet lite, klokke og strøm til høyre, fremdrift bare når noe hentes. -->
            <Grid Grid.Row="0" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="GAMEHOME" FontFamily="{StaticResource GhFontText}" FontSize="{StaticResource GhSizeSmall}" FontWeight="SemiBold"
                           CharacterSpacing="220" Foreground="{StaticResource GhTextTertiaryBrush}" VerticalAlignment="Center" />
                <StackPanel x:Name="ArtProgressPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar x:Name="ArtProgress" Width="120" VerticalAlignment="Center" />
                    <TextBlock x:Name="ArtProgressText" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}"
                               VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Varsler: bare synlig når noe trenger brukeren (for eksempel bilder som ikke ble funnet). -->
                <Button x:Name="NoticeButton" Grid.Column="2" Click="NoticeButton_Click" Height="40" Padding="12,0" CornerRadius="20"
                        Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                        AutomationProperties.Name="Varsler" ToolTipService.ToolTip="Varsler">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA8F;" FontSize="16" Foreground="{StaticResource GhTextSecondaryBrush}" />
                        <TextBlock x:Name="NoticeCount" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ClockText" Grid.Column="3" FontFamily="{StaticResource GhFontText}" FontSize="{StaticResource GhSizeBody}"
                           Foreground="{StaticResource GhTextSecondaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="PowerMenuButton" Grid.Column="4" Click="PowerMenuButton_Click" Width="48" Height="48"
                        Background="Transparent" BorderThickness="0" CornerRadius="24"
                        AutomationProperties.Name="Strøm og innstillinger" ToolTipService.ToolTip="Strøm og innstillinger">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="18" Foreground="{StaticResource GhTextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Hovedfeltet: spillet i fokus. Logo (eller tittel), én linje fakta og hva knappene gjør. -->
            <StackPanel x:Name="HeroInfo" Grid.Row="1" VerticalAlignment="Bottom" Spacing="12" Margin="0,0,0,8" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel.Resources>
                    <Storyboard x:Name="HeroFadeIn">
                        <DoubleAnimation Storyboard.TargetName="HeroInfo" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </StackPanel.Resources>
                <Grid MinHeight="120" VerticalAlignment="Bottom">
                    <Image x:Name="HeroLogo" MaxHeight="150" MaxWidth="520" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeDisplay}" FontWeight="SemiBold"
                               Foreground="{StaticResource GhTextPrimaryBrush}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock x:Name="HeroFacts" FontFamily="{StaticResource GhFontText}" FontSize="{StaticResource GhSizeBody}"
                           Foreground="{StaticResource GhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeroHint" FontFamily="{StaticResource GhFontText}" FontSize="{StaticResource GhSizeCaption}"
                           Foreground="{StaticResource GhTextTertiaryBrush}" Text="A  Spill      Y  Om spillet      ☰  Valg" />
            </StackPanel>

            <!-- Spillflisene lages i koden (ikke ItemsSource; se ADR 0005 om AOT). Plass rundt så flisen i fokus kan forstørres. -->
            <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="10,14" Margin="-10,0">
                <StackPanel x:Name="GameTiles" Orientation="Horizontal" Spacing="20" />
            </ScrollViewer>

            <!-- Verktøy: få og stille. Teknisk ligger under Feilsøking. -->
            <StackPanel x:Name="ToolTiles" Grid.Row="3" Orientation="Horizontal" Spacing="12">
                <Button x:Name="LibraryTile" Click="LibraryTile_Click" Height="48" Padding="18,0" FontSize="{StaticResource GhSizeCaption}" CornerRadius="24">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F1;" FontSize="14" />
                        <TextBlock x:Name="LibraryTileText" Text="Bibliotek" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddGameTile" Click="AddGameTile_Click" Height="48" Padding="18,0" FontSize="{StaticResource GhSizeCaption}" CornerRadius="24">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Legg til spill" />
                    </StackPanel>
                </Button>
                <Button x:Name="SteamLibraryTile" Click="SteamLibraryTile_Click" Visibility="Collapsed" Height="48" Padding="18,0" FontSize="{StaticResource GhSizeCaption}" CornerRadius="24">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Installer fra Steam" />
                    </StackPanel>
                </Button>
                <Button x:Name="DebugTile" Click="DebugTile_Click" Height="48" Padding="18,0" FontSize="{StaticResource GhSizeCaption}" CornerRadius="24">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEBE8;" FontSize="14" />
                        <TextBlock Text="Feilsøking" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--
          Bibliotek: alle spillene i et rutenett, med faner per kilde og sortering. Home viser bare «Fortsett» (sist spilt og
          festede). Ligger rett over Home og under alle andre paneler, så «Om spillet» og valg kan åpnes herfra.
        -->
        <Grid x:Name="LibraryPanel" Background="{StaticResource GhBaseBrush}" Visibility="Collapsed" Padding="{StaticResource GhPageMargin}" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LibraryHeading" Text="Bibliotek" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}"
                           FontWeight="SemiBold" Foreground="{StaticResource GhTextPrimaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="LibrarySortButton" Grid.Column="1" Click="LibrarySortButton_Click" Height="48" Padding="18,0" CornerRadius="24"
                        FontSize="{StaticResource GhSizeCaption}" ToolTipService.ToolTip="Sortering (X)" />
                <Button x:Name="LibraryCloseButton" Grid.Column="2" Content="Tilbake" Click="LibraryCloseButton_Click" Height="48" Padding="18,0"
                        CornerRadius="24" FontSize="{StaticResource GhSizeCaption}" />
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                <StackPanel x:Name="LibraryTabs" Orientation="Horizontal" Spacing="8" />
            </ScrollViewer>
            <ScrollViewer x:Name="LibraryScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden" Padding="8" Margin="-8,0">
                <VariableSizedWrapGrid x:Name="LibraryGrid" Orientation="Horizontal" ItemWidth="252" ItemHeight="150" />
            </ScrollViewer>
            <TextBlock Grid.Row="3" Text="A Spill · Y Om spillet · ☰ Valg og fest i Home · X Sortering · LB/RB Bytt fane · B Tilbake"
                       FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" />
        </Grid>

        <!--
          Lasteskjerm mens spillet starter: logo over et mørkt bakgrunnsbilde, eller tittelen i stor tekst.
          Forsvinner når spillet tar forgrunnen. B går tilbake til Home uten å stoppe spillet.
        -->
        <!--
          Lærdom fra Stremio og Nuvio (docs/architecture.md, «Lasteskjerm»): bakgrunnsbilde som fyller skjermen under et
          mørkt slør fra topp til bunn, logo midt på som toner inn og «puster» rolig, og status rett under logoen.
          Bakgrunnen glir svært sakte inn (egen idé, ikke fra appene). Skjules uten uttoning, som i Stremio.
        -->
        <Grid x:Name="LoadingPanel" Background="Black" Visibility="Collapsed">
            <Grid.Resources>
                <Storyboard x:Name="LoadingIntro">
                    <DoubleAnimation Storyboard.TargetName="LoadingHero" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5" />
                    <DoubleAnimation Storyboard.TargetName="LoadingCenter" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.65">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="LoadingPulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.04" Duration="0:0:2">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.04" Duration="0:0:2">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="HeroDrift">
                    <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.06" Duration="0:0:20" />
                    <DoubleAnimation Storyboard.TargetName="HeroScale" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.06" Duration="0:0:20" />
                </Storyboard>
            </Grid.Resources>
            <Image x:Name="LoadingHero" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top"
                   RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="HeroScale" />
                </Image.RenderTransform>
            </Image>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4D000000" Offset="0" />
                        <GradientStop Color="#99000000" Offset="0.35" />
                        <GradientStop Color="#CC000000" Offset="0.7" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Grid x:Name="LoadingCenter" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" />
                    </Grid.RenderTransform>
                    <Image x:Name="LoadingLogo" MaxWidth="560" MaxHeight="300" Stretch="Uniform" />
                    <TextBlock x:Name="LoadingTitle" FontSize="56" FontWeight="ExtraBold" Foreground="White"
                               TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" MaxWidth="1000" />
                </Grid>
                <TextBlock x:Name="LoadingStatus" FontSize="20" Foreground="#B8FFFFFF" HorizontalAlignment="Center" Height="32" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56" Spacing="20">
                <StackPanel x:Name="LoadingChoices" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="LoadingWaitButton" Content="Vent" Click="LoadingWaitButton_Click" Width="240" Height="64" FontSize="20" />
                    <Button x:Name="LoadingHomeButton" Content="Tilbake til Home" Click="LoadingHomeButton_Click" Width="240" Height="64" FontSize="20" />
                </StackPanel>
                <TextBlock Text="B: tilbake til Home (spillet fortsetter å starte)" FontSize="16" Foreground="#8A9199" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- «Kjører nå»: fullskjermspanel. Ingen overlay over spillet; GameHome tar forgrunnen. -->
        <Grid x:Name="SessionPanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="560">
                <TextBlock Text="Kjører nå" FontSize="20" Foreground="#A0A7B0" />
                <TextBlock x:Name="SessionTitle" FontSize="40" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionDetail" FontSize="16" Foreground="#A0A7B0" TextWrapping="Wrap" />
                <Button x:Name="ResumeButton" Content="Tilbake til spillet" Click="ResumeButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="EndSessionButton" Content="Avslutt spillet" Click="EndSessionButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="EndRemoteButton" Content="Avslutt spillet på gaming-PC-en" Click="EndRemoteButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" Visibility="Collapsed" />
                <Button x:Name="ClosePanelButton" Content="Lukk panelet" Click="ClosePanelButton_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <!-- Ytelse: skjermen styrer GameHome selv; TDP og resten ligger i Handheld Companions QuickTools (ADR 0007). -->
                <StackPanel x:Name="PerformancePanel" Spacing="8">
                    <TextBlock Text="Ytelse" FontSize="16" Foreground="#A0A7B0" />
                    <StackPanel x:Name="RefreshRateButtons" Orientation="Horizontal" Spacing="8" />
                    <StackPanel x:Name="ResolutionButtons" Orientation="Horizontal" Spacing="8" />
                    <Button x:Name="QuickToolsButton" Content="TDP, lysstyrke og mer" Click="QuickToolsButton_Click" HorizontalAlignment="Stretch" Height="52" FontSize="17"
                            ToolTipService.ToolTip="Åpner hurtigmenyen i Handheld Companion" />
                    <TextBlock x:Name="PerformanceStatus" FontSize="15" Foreground="#C8CDD3" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
                <!-- Feilsøking: bare når spillet strømmes fra gaming-PC-en. -->
                <StackPanel x:Name="StreamDebugPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Feilsøking" FontSize="16" Foreground="#A0A7B0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DebugStatsButton" Grid.Column="0" Content="Fps og ping" Click="DebugStatsButton_Click" HorizontalAlignment="Stretch" Height="52" FontSize="17"
                                ToolTipService.ToolTip="Viser eller skjuler Moonlights overlegg med fps, ping og bitrate" />
                        <Button x:Name="DebugTaskbarButton" Grid.Column="1" Content="Oppgavelinje" Click="DebugTaskbarButton_Click" HorizontalAlignment="Stretch" Height="52" FontSize="17"
                                ToolTipService.ToolTip="Viser eller skjuler oppgavelinjen og ikonene på gaming-PC-en" />
                        <Button x:Name="DebugStatusButton" Grid.Column="2" Content="Status" Click="DebugStatusButton_Click" HorizontalAlignment="Stretch" Height="52" FontSize="17"
                                ToolTipService.ToolTip="Hva Vibepollo på gaming-PC-en melder" />
                    </Grid>
                    <TextBlock x:Name="DebugStatusText" FontSize="15" Foreground="#C8CDD3" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="SessionPowerButton" Click="PowerMenuButton_Click" Width="52" Height="52" HorizontalAlignment="Right" Margin="0,8,0,0"
                        AutomationProperties.Name="Strøm" ToolTipService.ToolTip="Strøm">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="20" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Spill på PC-en: undermeny der brukeren velger hvilke installerte spill på gaming-PC-en som skal i Home. -->
        <Grid x:Name="HostPanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HostTitle" Grid.Row="0" Text="Spill fra gaming-PC" FontSize="34" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="HostStatus" Grid.Row="1" FontSize="18" Foreground="#C8CDD3" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HostGames" Spacing="8" />
                </ScrollViewer>
                <Button x:Name="HostCloseButton" Grid.Row="3" Content="Lukk" Click="HostCloseButton_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20" />
            </Grid>
        </Grid>

        <!-- Strømvalg. Avbryt har fokus, så et feiltrykk på A gjør ingenting. -->
        <Grid x:Name="PowerPanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="560">
                <TextBlock Text="Strøm og innstillinger" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource GhTextPrimaryBrush}" />
                <TextBlock x:Name="PowerText" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextSecondaryBrush}" TextWrapping="Wrap" />
                <Button Tag="sleep" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE708;" FontSize="20" />
                        <TextBlock Text="Dvale" />
                    </StackPanel>
                </Button>
                <Button Tag="restart" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="20" />
                        <TextBlock Text="Start på nytt" />
                    </StackPanel>
                </Button>
                <Button Tag="shutdown" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="20" />
                        <TextBlock Text="Slå av" />
                    </StackPanel>
                </Button>
                <Button Tag="exit" Click="PowerOption_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;" FontSize="20" />
                        <TextBlock Text="Avslutt GameHome" />
                    </StackPanel>
                </Button>
                <Button x:Name="SoundToggleButton" Click="SoundToggle_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE767;" FontSize="20" />
                        <TextBlock x:Name="SoundToggleText" Text="Menylyder: på" />
                    </StackPanel>
                </Button>
                <Button x:Name="PowerCancelButton" Content="Avbryt" Click="PowerCancel_Click" HorizontalAlignment="Stretch" Height="64" FontSize="20" />
            </StackPanel>
        </Grid>

        <!--
          Om spillet (Y): bakgrunnsbildet i full størrelse, logo, fakta på én linje, beskrivelse og spilletid. Én tydelig
          handling (Spill); B lukker.
        -->
        <Grid x:Name="DetailsPanel" Background="{StaticResource GhBaseBrush}" Visibility="Collapsed">
            <Image x:Name="DetailsHero" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F7121110" Offset="0" />
                        <GradientStop Color="#CC121110" Offset="0.5" />
                        <GradientStop Color="#33121110" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00121110" Offset="0.4" />
                        <GradientStop Color="#FF121110" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <ScrollViewer Padding="{StaticResource GhPageMargin}" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="DetailsContent" Spacing="18" MaxWidth="780" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,40,0,24">
                    <Grid MinHeight="110">
                        <Image x:Name="DetailsLogo" MaxHeight="140" MaxWidth="480" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="DetailsTitle" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeDisplay}" FontWeight="SemiBold"
                                   Foreground="{StaticResource GhTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock x:Name="DetailsFacts" FontFamily="{StaticResource GhFontText}" FontSize="{StaticResource GhSizeBody}"
                               Foreground="{StaticResource GhTextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="40">
                        <StackPanel x:Name="DetailsScoreBox" Spacing="2" Visibility="Collapsed">
                            <TextBlock x:Name="DetailsScore" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                                       Foreground="{StaticResource GhTextPrimaryBrush}" />
                            <TextBlock Text="Metacritic" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="DetailsPlayed" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                                       Foreground="{StaticResource GhTextPrimaryBrush}" />
                            <TextBlock x:Name="DetailsPlayedLabel" Text="Spilt i GameHome" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="DetailsModes" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                                       Foreground="{StaticResource GhTextPrimaryBrush}" />
                            <TextBlock Text="Spilles" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="DetailsDescription" FontFamily="{StaticResource GhFontText}" FontSize="{StaticResource GhSizeBody}" LineHeight="30"
                               Foreground="{StaticResource GhTextPrimaryBrush}" TextWrapping="Wrap" MaxLines="6" TextTrimming="WordEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="DetailsPlayButton" Click="DetailsPlayButton_Click" Height="56" MinWidth="200" Padding="28,0" CornerRadius="28"
                                FontSize="{StaticResource GhSizeBody}" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="16" />
                                <TextBlock x:Name="DetailsPlayText" Text="Spill" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DetailsOptionsButton" Content="Valg" Click="DetailsOptionsButton_Click" Height="56" Padding="24,0" CornerRadius="28"
                                FontSize="{StaticResource GhSizeBody}" />
                        <Button x:Name="DetailsCloseButton" Content="Lukk" Click="DetailsCloseButton_Click" Height="56" Padding="24,0" CornerRadius="28"
                                FontSize="{StaticResource GhSizeBody}" />
                    </StackPanel>
                    <TextBlock x:Name="DetailsSource" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Valg for spillet (☰/Start): bilder og info på nytt, standard spillemåte, strømprofil, fjern. -->
        <Grid x:Name="OptionsPanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="0,24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="560">
                <TextBlock Text="Valg" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextTertiaryBrush}" />
                <TextBlock x:Name="OptionsTitle" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource GhTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button x:Name="OptionFind" Style="{StaticResource GhPanelButton}" Content="Finn riktig spill eller endre navn" Click="OptionFind_Click" />
                <Button x:Name="OptionArt" Style="{StaticResource GhPanelButton}" Content="Velg bilder" Click="OptionArt_Click" />
                <Button x:Name="OptionDefaultMode" Style="{StaticResource GhPanelButton}" Click="OptionDefaultMode_Click" />
                <Button x:Name="OptionSource" Style="{StaticResource GhPanelButton}" Click="OptionSource_Click">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="OptionSourceText" />
                        <TextBlock x:Name="OptionSourceHint" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="OptionRefreshArt" Style="{StaticResource GhPanelButton}" Content="Hent bilder på nytt" Click="OptionRefreshArt_Click" />
                <Button x:Name="OptionRefreshInfo" Style="{StaticResource GhPanelButton}" Content="Hent info på nytt" Click="OptionRefreshInfo_Click" />
                <Button x:Name="OptionPowerProfile" Style="{StaticResource GhPanelButton}" Click="OptionPowerProfile_Click">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Strømprofil" />
                        <TextBlock x:Name="OptionPowerProfileText" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="OptionPin" Style="{StaticResource GhPanelButton}" Click="OptionPin_Click" />
                <Button x:Name="OptionRemove" Style="{StaticResource GhPanelButton}" Content="Fjern fra GameHome" Click="OptionRemove_Click" />
                <Button x:Name="OptionsCloseButton" Style="{StaticResource GhPanelButton}" Content="Lukk" Click="OptionsCloseButton_Click" Margin="0,12,0,0" />
                <TextBlock x:Name="OptionsStatus" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
          Velg bilder: én fane per kilde. I hver fane bakgrunn, logo og omslag; valget lagres som brukerens eget og vinner
          over alt annet. Forhåndsbildene er små og slippes når panelet lukkes.
        -->
        <Grid x:Name="ArtPanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <Grid Padding="{StaticResource GhPageMargin}" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Velg bilder" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextTertiaryBrush}" />
                <TextBlock x:Name="ArtTitle" Grid.Row="1" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource GhTextPrimaryBrush}" />
                <StackPanel Grid.Row="2" Spacing="6">
                    <StackPanel x:Name="ArtTabs" Orientation="Horizontal" Spacing="8" />
                    <TextBlock x:Name="ArtStatus" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer x:Name="ArtScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ArtSections" Spacing="16" />
                </ScrollViewer>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ArtResetButton" Content="Tilbake til automatisk" Click="ArtResetButton_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                    <Button x:Name="ArtCloseButton" Content="Lukk" Click="ArtCloseButton_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Varsler: det som ikke gikk, med en knapp for å rette det. -->
        <Grid x:Name="NoticePanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" RowSpacing="12" Padding="0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Varsler" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource GhTextPrimaryBrush}" />
                <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NoticeList" Spacing="8" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button x:Name="NoticeClearButton" Content="Fjern alle" Click="NoticeClearButton_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                    <Button x:Name="NoticeCloseButton" Content="Lukk" Click="NoticeCloseButton_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--
          Finn riktig spill: søk på Steam med det GameHome gjettet (rediger med skjermtastaturet), velg treffet med
          kontrolleren, eller bruk navnet uten Steam.
        -->
        <Grid x:Name="FindPanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" RowSpacing="12" Padding="0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="FindHeading" Text="Finn riktig spill" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextTertiaryBrush}" />
                <TextBlock x:Name="FindTitle" Grid.Row="1" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource GhTextPrimaryBrush}" TextWrapping="Wrap" />
                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FindQuery" FontSize="{StaticResource GhSizeBody}" Height="52" VerticalContentAlignment="Center"
                             PlaceholderText="Navnet på spillet" KeyDown="FindQuery_KeyDown" />
                    <Button x:Name="FindSearchButton" Grid.Column="1" Content="Søk på Steam" Click="FindSearchButton_Click" Height="52" Padding="20,0"
                            FontSize="{StaticResource GhSizeCaption}" />
                </Grid>
                <TextBlock x:Name="FindStatus" Grid.Row="3" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextSecondaryBrush}" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="4" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FindResults" Spacing="8" />
                </ScrollViewer>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button x:Name="FindUseNameButton" Content="Bruk navnet uten Steam" Click="FindUseNameButton_Click" Height="52" Padding="20,0"
                            FontSize="{StaticResource GhSizeCaption}" />
                    <Button x:Name="FindCloseButton" Content="Lukk" Click="FindCloseButton_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Feilsøking: alt det tekniske som før lå i Home. -->
        <Grid x:Name="DebugPanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <Grid Padding="{StaticResource GhPageMargin}" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Feilsøking" FontFamily="{StaticResource GhFontDisplay}" FontSize="{StaticResource GhSizeTitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource GhTextPrimaryBrush}" />
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock x:Name="InfoText" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextSecondaryBrush}" />
                    <TextBlock x:Name="MemoryText" FontFamily="Consolas" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextSecondaryBrush}" Text="Minne: –" />
                    <TextBlock x:Name="StartupText" FontFamily="Consolas" FontSize="{StaticResource GhSizeSmall}" Foreground="{StaticResource GhTextTertiaryBrush}" Text="Oppstart: –" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="TestHostTile" Content="Test tilkobling" Click="TestHostTile_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                    <Button x:Name="HidTile" Content="Lytt på Legion-knapp" Click="HidTile_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                    <Button x:Name="WifiReconnectTile" Content="Koble til Wi-Fi på nytt" Click="WifiReconnectTile_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                    <Button x:Name="DebugCloseButton" Content="Lukk" Click="DebugCloseButton_Click" Height="52" Padding="20,0" FontSize="{StaticResource GhSizeCaption}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="10">
                    <TextBlock Text="M2 i spill som blokkerer hurtigtaster" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="FlagHook" Tag="hook" Click="FocusFlag_Click" Height="48" Padding="16,0" FontSize="{StaticResource GhSizeSmall}" />
                        <Button x:Name="StoreAutostartTile" Content="Butikkklienter og oppstart" Click="StoreAutostartTile_Click" Height="48" Padding="16,0" FontSize="{StaticResource GhSizeSmall}" />
                        <Button x:Name="SteamCloseTile" Click="SteamCloseTile_Click" Height="48" Padding="16,0" FontSize="{StaticResource GhSizeSmall}" />
                    </StackPanel>
                    <!-- Resultatet av «Test tilkobling» vises her, ikke i et eget panel. -->
                    <TextBlock x:Name="DebugResultText" FontSize="{StaticResource GhSizeBody}" Foreground="{StaticResource GhTextPrimaryBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="LastInput" FontSize="{StaticResource GhSizeCaption}" Foreground="{StaticResource GhTextSecondaryBrush}" TextWrapping="Wrap"
                               Text="A starter spillet, Y viser info, ☰ gir valg. M2 under spill åpner menyen." />
                </StackPanel>
                <!-- Vanlig tekst, ikke liste: en .NET-samling som ItemsSource krever ekstra AOT-generering (se loggen 2026-11-02). -->
                <TextBlock x:Name="EventText" Grid.Row="4" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource GhTextTertiaryBrush}" TextWrapping="NoWrap" />
            </Grid>
        </Grid>

        <!-- Valg ved feil og bekreftelser. Alltid to tydelige valg, aldri en blindvei. -->
        <Grid x:Name="MessagePanel" Background="{StaticResource GhScrimBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="620">
                <TextBlock x:Name="MessageTitle" FontSize="34" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" FontSize="18" Foreground="#C8CDD3" TextWrapping="Wrap" />
                <Button x:Name="MessagePrimary" Click="MessagePrimary_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
                <Button x:Name="MessageSecondary" Click="MessageSecondary_Click" HorizontalAlignment="Stretch" Height="72" FontSize="22" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
