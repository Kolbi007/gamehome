<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!--
  Identity Name er nøytralt og permanent. Publisher må være lik emnet i signeringssertifikatet
  (scripts/New-DevCertificate.ps1).

  Fase 0A (eksperimentell): app-utvidelsen windows.gamingApp og den egendefinerte capability-en gamingHome gjør
  GameHome valgbar som home app i Xbox mode. Capability-en krever CustomCapability.SCCD i pakkeroten og at
  utviklermodus er på ved installasjon. Uten FSE fungerer GameHome som vanlig app.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap4="http://schemas.microsoft.com/appx/manifest/uap/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap4 rescap">

  <Identity Name="GameHome" Publisher="CN=GameHome Dev" Version="0.1.0.0" />

  <Properties>
    <DisplayName>GameHome</DisplayName>
    <PublisherDisplayName>GameHome contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="GameHome"
        Description="Controller-first spillbibliotek for Windows Xbox mode."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0D10" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="windows.gamingApp" Id="App" DisplayName="GameHome"
            Description="Controller-first spillbibliotek for Windows Xbox mode." PublicFolder="Public" />
        </uap3:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="gamehome">
            <uap:DisplayName>GameHome</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap4:CustomCapability Name="Microsoft.appCategory.gamingHome_8wekyb3d8bbwe" />
  </Capabilities>
</Package>
